#!/bin/sh

BESPOK3D=/userdata/bespok3d
PLUGIN=$BESPOK3D/usr/local/plugins/thermal-p1
BIN=$PLUGIN/bin
RUN=$BESPOK3D/run
PIDFILE=$RUN/thermal-p1.pid
BIND=127.0.0.1
PORT=8082

start() {
    mkdir -p "$RUN"
    umask 0022
    printf "Starting thermal-p1: "
    start-stop-daemon -S -b -q -m -p "$PIDFILE" -x /usr/bin/python3 -- \
        "$BIN/thermal-p1-stream.py" --bind "$BIND" --port "$PORT"
    echo "OK"
}

stop() {
    printf "Stopping thermal-p1: "
    start-stop-daemon -K -q -p "$PIDFILE" 2>/dev/null || true
    echo "OK"
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "thermal-p1: running (pid $(cat "$PIDFILE"))"
    elif [ -f "$PIDFILE" ]; then
        echo "thermal-p1: dead (stale pidfile)"
    else
        echo "thermal-p1: stopped"
    fi
}

case "$1" in
    start)          start ;;
    stop)           stop ;;
    restart|reload) stop; sleep 1; start ;;
    status)         status ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
