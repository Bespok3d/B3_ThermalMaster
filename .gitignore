.ruff_cache/

# PyPI configuration file
.pypirc

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Streamlit
.streamlit/secrets.toml

# Vendor specific files
# Build output (the baked wheel trees) is ignored; the pinned upstream driver is not. It is one
# source file and its licence, checked in so that what ships is reviewable in a diff and cannot
# change under us when upstream moves. See VENDORING.md.
plugin/files/vendor/*
!plugin/files/vendor/p3_camera.py
!plugin/files/vendor/LICENSE.p3-ir-camera
plugin/files/wheels/

thermal-camera-P3-viewer/
thermal-camera-P3-viewer/*
# macOS turds. These are payload if they land under plugin/files, and the daemon refuses a package
# holding an archive member its manifest does not list.
.DS_Store

# Compiled modules under plugin/files would be packed into the .b3, where the daemon refuses any
# archive member not listed in files[].
plugin/files/**/__pycache__/

# Where an assistant puts anything it would otherwise delete, so the maintainer can look before it
# goes. Never committed, and safe to empty by hand.
_trash/

# Frames captured off a real printer for judging a rendering change. Data, not source: they are
# big, they are binary, and the decision they inform gets written down rather than the megabytes.
reference/frames/
