# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# ...except this plugin's own modules. The rule above comes from the standard Python template,
# where lib/ means a build artifact. Here it silently matched plugin/files/lib, which is the
# entire plugin: the package still built, because b3-builder reads the working tree rather than
# git, so the first sign would have been a commit whose plugin had no code in it.
!plugin/files/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#   Usually these files are written by a python script from a template
#   before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

